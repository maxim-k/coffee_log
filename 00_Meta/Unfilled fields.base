# Notes with at least one empty property, one view per note kind.
# A blank cell is the missing field. Add a property here when a template
# gains one.
views:
  - type: table
    name: Bags
    filters:
      and:
        - 'file.inFolder("Bags")'
        - or:
            - 'note["Roaster"].isEmpty()'
            - 'note["Name"].isEmpty()'
            - 'note["Product page"].isEmpty()'
            - 'note["Photo"].isEmpty()'
            - 'note["Roast date"].isEmpty()'
            - 'note["Open date"].isEmpty()'
            - 'note["Bag size (g)"].isEmpty()'
            - 'note["Price paid ($)"].isEmpty()'
            - 'note["Rating"].isEmpty()'
            - 'note["Producer"].isEmpty()'
            - 'note["Country"].isEmpty()'
            - 'note["Region"].isEmpty()'
            - 'note["Farm"].isEmpty()'
            - 'note["Lot"].isEmpty()'
            - 'note["Variety"].isEmpty()'
            - 'note["Process"].isEmpty()'
            - 'note["Elevation"].isEmpty()'
            - 'note["Roast level"].isEmpty()'
            - 'note["Tasting notes"].isEmpty()'
    order:
      - file.name
      - note.Roaster
      - note.Name
      - note.Product page
      - note.Photo
      - note.Roast date
      - note.Open date
      - note.Bag size (g)
      - note.Price paid ($)
      - note.Rating
      - note.Producer
      - note.Country
      - note.Region
      - note.Farm
      - note.Lot
      - note.Variety
      - note.Process
      - note.Elevation
      - note.Roast level
      - note.Tasting notes
  - type: table
    name: Brews
    filters:
      and:
        - 'file.inFolder("Brews")'
        - or:
            - 'note["Bag"].isEmpty()'
            - 'note["Grinder"].isEmpty()'
            - 'note["Grind"].isEmpty()'
            - 'note["Brewer"].isEmpty()'
            - 'note["Water"].isEmpty()'
            - 'note["Filter paper"].isEmpty()'
            - 'note["Dose (g)"].isEmpty()'
            - 'note["Water weight (g)"].isEmpty()'
            - 'note["Ratio"].isEmpty()'
            - 'note["Temperature (°C)"].isEmpty()'
            - 'note["Total time"].isEmpty()'
            - 'note["Pour"].isEmpty()'
            - 'note["Rating"].isEmpty()'
    order:
      - file.name
      - note.Bag
      - note.Grinder
      - note.Grind
      - note.Brewer
      - note.Water
      - note.Filter paper
      - note.Dose (g)
      - note.Water weight (g)
      - note.Ratio
      - note.Temperature (°C)
      - note.Total time
      - note.Pour
      - note.Rating
  - type: table
    name: Roasters
    filters:
      and:
        - 'file.inFolder("Roasters")'
        - or:
            - 'note["Website"].isEmpty()'
            - 'note["City"].isEmpty()'
            - 'note["Country"].isEmpty()'
    order:
      - file.name
      - note.Website
      - note.City
      - note.Country
  - type: table
    name: Producers
    filters:
      and:
        - 'file.inFolder("Producers")'
        - or:
            - 'note["Country"].isEmpty()'
            - 'note["Region"].isEmpty()'
    order:
      - file.name
      - note.Country
      - note.Region
  - type: table
    name: Varieties
    filters:
      and:
        - 'file.inFolder("Varieties")'
        - or:
            - 'note["Parent"].isEmpty()'
            - 'note["Genetic group"].isEmpty()'
    order:
      - file.name
      - note.Parent
      - note.Genetic group
  - type: table
    name: Brewers
    filters:
      and:
        - 'file.inFolder("Brewers")'
        - or:
            - 'note["Manufacturer"].isEmpty()'
            - 'note["Model"].isEmpty()'
            - 'note["Material"].isEmpty()'
    order:
      - file.name
      - note.Manufacturer
      - note.Model
      - note.Material
  - type: table
    name: Grinders
    filters:
      and:
        - 'file.inFolder("Grinders")'
        - or:
            - 'note["Burr type"].isEmpty()'
            - 'note["True zero"].isEmpty()'
            - 'note["Clicks per rotation"].isEmpty()'
            - 'note["Clicks per number"].isEmpty()'
            - 'note["Travel per click (µm)"].isEmpty()'
            - 'note["Burr gap per click (µm)"].isEmpty()'
    order:
      - file.name
      - note.Burr type
      - note.True zero
      - note.Clicks per rotation
      - note.Clicks per number
      - note.Travel per click (µm)
      - note.Burr gap per click (µm)
  - type: table
    name: Waters
    filters:
      and:
        - 'file.inFolder("Waters")'
        - or:
            - 'note["Kind"].isEmpty()'
            - 'note["hardness_caco3_mg_l"].isEmpty()'
            - 'note["alkalinity_caco3_mg_l"].isEmpty()'
    order:
      - file.name
      - note.Kind
      - note.hardness_caco3_mg_l
      - note.alkalinity_caco3_mg_l
